<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Precompile the runner's code (mostly the F# parser in Fantomas.FCS) when it is published,
         so that it doesn't go through the JIT on every run. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Globalization.Invariant" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Core.fs" />
    <Compile Include="Visitor.fs" />
    <Compile Include="Rewrite.fs" />
    <Compile Include="FastPath.fs" />
    <Compile Include="Testing.fs" />
    <Compile Include="Output.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Fantomas.Core" Version="7.0.6" />
    <PackageReference Include="Fantomas.FCS" Version="7.0.6" />
    <PackageReference Include="Humanizer.Core" Version="3.0.10" />
    <PackageReference Update="FSharp.Core" Version="10.1.403" />
  </ItemGroup>

</Project>
